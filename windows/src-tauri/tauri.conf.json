{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Darnell Jr.",
  "mainBinaryName": "WorkClock",
  "version": "1.4.0",
  "identifier": "au.com.teamangeleski.workclock",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Team Angeleski",
    "shortDescription": "A focus clock that races your friends",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
